{
	"name": "yh-mp-preview",
	"version": "3.15.1-beta.1",
	"description": "一键将 Markdown 文档转换为微信公众号格式",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test tests/*.test.mjs",
		"lint:host": "eslint src",
		"check:host": "node scripts/check-host-audit.mjs",
		"audit:themes": "node scripts/audit-themes.mjs --check",
		"audit:themes:write": "node scripts/audit-themes.mjs --write",
		"audit:core-themes": "node scripts/audit-core-theme-baseline.mjs --check",
		"audit:core-themes:write": "node scripts/audit-core-theme-baseline.mjs --write",
		"audit:wechat": "node scripts/audit-wechat-compatibility.mjs --check",
		"audit:wechat:write": "node scripts/audit-wechat-compatibility.mjs --write",
		"preview:themes": "node scripts/render-mobile-theme-fixture.mjs",
		"check:text": "node scripts/check-text-encoding.mjs",
		"sync-version": "node scripts/version-bump.mjs",
		"check:release": "node scripts/check-release.mjs",
		"verify": "npm run test && npm run check:text && npm run audit:themes && npm run audit:core-themes && npm run audit:wechat && npm run check:host && npm run check:release",
		"version": "npm run sync-version"
	},
	"keywords": [
		"obsidian",
		"plugin"
	],
	"author": "yhwang",
	"license": "AGPL-3.0-or-later",
	"engines": {
		"node": ">=22.22.2"
	},
	"overrides": {
		"moment": "2.31.0"
	},
	"devDependencies": {
		"@codemirror/state": "6.5.2",
		"@codemirror/view": "6.36.3",
		"@eslint/js": "9.39.5",
		"@eslint/json": "0.14.0",
		"@types/node": "^16.11.6",
		"esbuild": "0.28.2",
		"eslint": "10.11.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"jsdom": "26.1.0",
		"obsidian": "1.8.7",
		"tslib": "2.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.0"
	},
	"dependencies": {
		"dompurify": "3.4.16",
		"html2canvas": "^1.4.1",
		"nanoid": "5.1.16",
		"pangu": "^7.2.0"
	}
}
